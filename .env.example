# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Supabase — @nuxtjs/supabase reads these directly
SUPABASE_URL=
SUPABASE_KEY=

# Telco lookup API (Step 5) — base URL only; per-call auth uses each
# user's Supabase JWT (the lookup service verifies it against Supabase)
NUXT_PUBLIC_CORE_CHECK_BASE_URL=
